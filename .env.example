# dsh-web-research — backend settings template.
#
# Copy this file to `.env` and edit: the plugin loads `.env` from the bundle
# directory at startup (or the file named by DSH_WEBRESEARCH_ENV_FILE).
# Per-field precedence: row `config` > process env > `.env` > Python default.
# The pipeline reads exactly these WEBRESEARCH_* / CAMOFOX_* variable names;
# every variable that is unset or empty falls back to the pipeline default,
# so only the values your setup actually needs are required.
#
# === Required for web_recall / web_research recall stage ===
# Hister archive: URL of the Hister server and its API token.
WEBRESEARCH_HISTER_URL=http://127.0.0.1:4434
WEBRESEARCH_HISTER_TOKEN=change-me
# Optional path to a `hister` binary (defaults to `hister` on PATH).
#WEBRESEARCH_HISTER_BIN=/path/to/hister

# === Live discovery (web_research) ===
# SearXNG JSON endpoint used for live search.
WEBRESEARCH_SEARXNG_URL=http://127.0.0.1:8888

# === Fetching ===
# Python interpreter of the wreq TLS-fingerprint fetcher venv. Required only
# for wreq fetching; the pipeline falls back to the other fetch path when
# unset and wreq is selected.
WEBRESEARCH_WREQ_PY=/path/to/wreq-venv/bin/python
# Working directory for wreq fetch jobs (default: /tmp).
#WEBRESEARCH_WORK_DIR=/tmp

# Camofox browser fallback for pages that need JavaScript.
CAMOFOX_URL=http://localhost:9377
CAMOFOX_API_KEY=change-me
WEBRESEARCH_CAMOFOX_FALLBACK=true
# Optional cookie file (Netscape format) used by the fetchers.
WEBRESEARCH_COOKIES_FILE=/path/to/cookies.txt

# === Optional rerank ===
# Rerank model endpoint and model name; leave unset to skip reranking.
WEBRESEARCH_RERANK_URL=http://127.0.0.1:8080
WEBRESEARCH_RERANK_MODEL=jina-reranker-v3
#WEBRESEARCH_RERANK_TOKEN=
WEBRESEARCH_RERANK_MAX_CHARS=8000

# === Tuning & reporting ===
# Cache freshness window in days (0 = never serve from cache; default 10).
#WEBRESEARCH_REFRESH_MAX_DAYS=10
# Extra spam/mirror domains (comma-separated) and allowlist (always wins).
#WEBRESEARCH_BLOCKED_DOMAINS=
#WEBRESEARCH_ALLOWED_DOMAINS=
# Structured logs directory (default: ~/.dsh/logs/web-research.log).
#WEBRESEARCH_LOGS_DIR=
# Label attached to pipeline diagnostics entries (default: web-research).
WEBRESEARCH_LABEL=web-research
